@startuml
' Fonte editável. Renderização: java -jar plantuml.jar -charset UTF-8 -tsvg *.puml
left to right direction
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowColor #334155
skinparam actorBorderColor #334155
skinparam actorFontColor #0F172A
skinparam usecaseBackgroundColor #F8FAFC
skinparam usecaseBorderColor #475569
skinparam rectangleBorderColor #64748B
skinparam packageStyle rectangle
skinparam nodesep 32
skinparam ranksep 55
title Tarefas e rotina\nApp de Organização Familiar · MVP 1.0

actor "Administrador" as Admin
actor "Membro" as Membro
actor "Kids" as Kids

rectangle "App de Organização Familiar" {
  usecase "UC07\nGerenciar tarefas" as UC07
  usecase "UC08\nDefinir recorrência de\nrotina" as UC08
  usecase "UC11\nVisualizar minhas tarefas" as UC11
  usecase "UC12\nConcluir tarefa" as UC12
  usecase "UC13\nVisualizar carga semanal" as UC13
  usecase "UC17\nRetornar tarefa concluída\npara Pendente" as UC17
}

Admin -- UC07
Admin -- UC08
Admin -- UC11
Admin -- UC12
Admin -- UC13
Admin -- UC17
Membro -- UC07
Membro -- UC08
Membro -- UC11
Membro -- UC12
Membro -- UC13
Kids -- UC11
UC08 ..> UC07 : <<extend>>\n[configurar repetição]
note right of UC07
  Ponto de extensão:
  configuração de repetição.
end note
note right of UC17
  Somente Administrador. Exige vínculo com
  missão em andamento e nenhum vínculo
  com missão concluída.
end note

@enduml
