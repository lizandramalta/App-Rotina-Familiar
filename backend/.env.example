# ==============================================================================
# APP ROTINA FAMILIAR — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Use este arquivo como modelo para criar seu arquivo .env local:
#   cp .env.example .env
#
# NUNCA versione credenciais ou chaves reais de produção neste repositório.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE E SERVIDOR HTTP
# ------------------------------------------------------------------------------
# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta e host para o servidor Fastify HTTP
PORT=3000
HOST=0.0.0.0

# URL base pública da API (usada na documentação OpenAPI). No serviço de
# produção no Render: https://app-rotina-familiar.onrender.com (sem /v1).
API_BASE_URL=http://localhost:3000

# Nível de log estruturado (pino): trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# Conexão PostgreSQL gerenciada pelo Supabase (BA-01, BA-05, BA-19).
# Pegue a string no botão "Connect" do painel, em Connection Method > Session pooler.
# NÃO acrescente "?sslmode=require": o pg trata isso como verify-full e a conexão
# falha com "self-signed certificate in certificate chain". Use DATABASE_SSL=true.
#
# Padrão: conexão via Supavisor (modo sessão, IPv4, recomendado; porta 5432, não 6543).
# Substitua [PROJECT-REF], [PASSWORD] e [REGION] pelos valores do seu projeto.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Alternativas:
# Conexão direta (só funciona em rede com IPv6):
#   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Exemplo se usar Supabase CLI local (nesse caso, use DATABASE_SSL=false):
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Schema isolado do produto (conforme definido na arquitetura backend, BA-19)
DATABASE_SCHEMA=app

# Pool de conexões do driver node-postgres (pg)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Exigir SSL para a conexão (obrigatório no Supabase remoto; use false apenas
# com o Supabase CLI local). NÃO use "?sslmode=require" no DATABASE_URL.
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 3. SEGURANÇA E SESSÃO PRÓPRIA
# ------------------------------------------------------------------------------
# Segredo para hashing e proteção de tokens de sessão (BA-10, BA-273).
# Em produção, gere uma sequência aleatória forte (mínimo 32 caracteres).
SESSION_SECRET=change-this-to-a-secure-random-32-chars-secret

# Chave criptográfica (AES-GCM 256 bits / 32 bytes) para o envelope de recuperação de ingresso (BA-11, BA-275).
# Em produção, deve ser uma chave hexadecimal de 64 caracteres ou string segura de 32 bytes.
INVITE_ENVELOPE_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Base pública do link de convite (SPEC-004); o link é <base>/invite/<token>.
# O Worker público serve o arquivo AASA e a página de fallback. O mesmo host
# deve constar em INVITE_LINK_HOST nos builds mobile assinados.
INVITE_LINK_BASE_URL=https://convites.rotina-familiar.workers.dev

# Limite de tentativas do ingresso por convite (SPEC-005). Janela em minutos.
INVITE_ATTEMPT_LIMIT=5
INVITE_ORIGIN_ATTEMPT_LIMIT=30
INVITE_ATTEMPT_WINDOW_MINUTES=15

# Ligue somente atrás de um proxy confiável, para `request.ip` refletir o cliente.
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 4. ARMAZENAMENTO DE MÍDIA (OPCIONAL NA BASE / FASE 0)
# ------------------------------------------------------------------------------
# Cloudflare R2 (Armazenamento privado de mídia/fotos - BA-01, BA-16):
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=app-rotina-familiar-media-dev
# R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# 5. SIGN IN WITH APPLE (BA-01, BA-04, SPEC-001)
# ------------------------------------------------------------------------------
# Passo a passo de obtenção das credenciais: docs/apple-integration-setup.md
#
# Resiliência por ambiente:
#   - development e test: as credenciais abaixo são OPCIONAIS. O backend sobe sem
#     elas para não bloquear o desenvolvimento local. Quando informadas, o
#     formato é validado.
#   - production: APPLE_TEAM_ID, APPLE_KEY_ID e APPLE_PRIVATE_KEY são
#     OBRIGATÓRIAS. O boot falha imediatamente (fail-fast) se faltarem ou
#     estiverem malformadas.
#
# Deixar uma variável vazia equivale a não informá-la.

# Bundle ID do app iOS (audiência esperada no identityToken da Apple).
APPLE_CLIENT_ID=com.lizandramalta.familyroutine

# Team ID da conta Apple Developer: exatamente 10 caracteres alfanuméricos.
# Apple Developer > Membership details > Team ID.
# APPLE_TEAM_ID=ABCDE12345

# Key ID da chave "Sign in with Apple": exatamente 10 caracteres alfanuméricos.
# Apple Developer > Certificates, Identifiers & Profiles > Keys.
# APPLE_KEY_ID=KEY1234567

# Conteúdo do arquivo .p8 baixado da Apple, em formato PEM. O download é único:
# guarde a chave em um gerenciador de segredos. Em arquivos .env, mantenha tudo
# em uma linha, entre aspas, usando "\n" literal nas quebras — o backend
# normaliza para quebras reais antes de usar. A chave é validada de fato pelo
# Node no boot: delimitadores corretos com conteúdo corrompido são recusados.
# Em production exige-se ainda EC na curva P-256 (prime256v1), que é o que a Apple
# emite: ES256 é definido com P-256, e outra curva faria a Apple recusar a troca.
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49...\n-----END PRIVATE KEY-----"

# Endpoints canônicos da Apple. Sobrescrever é permitido apenas em development e
# test, para apontar a um stub; em production o boot exige exatamente estes valores.
APPLE_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_TOKEN_URL=https://appleid.apple.com/auth/token

# ------------------------------------------------------------------------------
# 6. OUTRAS INTEGRAÇÕES PREVISTAS PELA ARQUITETURA (OPCIONAIS NA BASE / FASE 0)
# ------------------------------------------------------------------------------

# APNs - Apple Push Notification service (BA-17):
# APNS_KEY_ID=your-apns-key-id
# APNS_TEAM_ID=your-apple-team-id
# APNS_TOPIC=com.rotinafamiliar.app
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
