{
  "name": "app-rotina-familiar-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend monólito modular da plataforma App de Rotina Familiar",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/bootstrap/api-main.ts",
    "dev:worker": "tsx watch src/bootstrap/worker-main.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/bootstrap/api-main.js",
    "start:worker": "node dist/bootstrap/worker-main.js",
    "migrate": "tsx database/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_INTEGRATION_TESTS=1 vitest run tests/integration",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^5.2.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^5.0.3"
  }
}
